<?xml version="1.0" encoding="utf-8"?>
<!--
  AndroidManifest.xml — what the app is and what it may do.

  Permissions (each one is needed, nothing more):
    INTERNET                     talk to your PC over Wi-Fi
    ACCESS_WIFI_STATE / WAKE_LOCK
                                 hold a "low-latency" Wi-Fi lock while the remote
                                 is on screen (stops Wi-Fi power-saving lag)
    CHANGE_WIFI_MULTICAST_STATE  find your PC on the network (mDNS) after its IP
                                 address changes
    CAMERA                       scan the pairing QR code (declared by the
                                 scanner library; only used when you tap Scan)

  Privacy:
    allowBackup="false" + dataExtractionRules: your pairing codes are never
    copied into Google/cloud backups or device-to-device transfers.
    networkSecurityConfig: plain unencrypted HTTP is forbidden.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Short vibration when you click (Settings → Vibrate on click). No prompt. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.RemoteMouse">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden|keyboard|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
